// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                Int         @id @default(autoincrement())
  status            String      @default("pending")
  subtotalToman     Int         @default(0)
  shippingCostToman Int         @default(0)
  totalToman        Int
  note              String?
  recipientName     String?
  recipientPhone    String?
  province          String?
  city              String?
  postalAddress     String?
  postalCode        String?
  shippingMethod    String      @default("standard")
  paymentStatus     String      @default("pending")
  paymentMethod     String      @default("mock_gateway")
  paymentReference  String?
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  items             OrderItem[]
  user              User?       @relation(fields: [userId], references: [id])
  userId            Int?
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  order          Order   @relation(fields: [orderId], references: [id])
  orderId        Int
  itemId         String
  nameFa         String
  unitPriceToman Int
  quantity       Int
  grindOption    String?
}

model Product {
  id                 Int      @id @default(autoincrement())
  slug               String   @unique
  nameFa             String
  description        String
  priceToman         Int
  priceOnRequest     Boolean  @default(false)
  compareAtPrice     Int?
  category           String
  stockQuantity      Int      @default(0)
  imageUrl           String?
  coffeeType         String?
  roastLevel         String?
  strength           Int?
  bitterness         Int?
  acidity            Int?
  flavorNotes        String[] @default([])
  suitableFor        String[] @default([])
  brewMethods        String[] @default([])
  grindingAvailable  Boolean  @default(false)
  grindOptions       String[] @default([])
  weightGrams        Int?
  isAvailable        Boolean  @default(true)
  price250g          Int?
  price500g          Int?
  price1000g         Int?
  priceBasisGrams    Int?
  minimumOrderGrams  Int?
  wholesaleAvailable Boolean  @default(false)
  catalogOnly        Boolean  @default(false)
  productForm        String?
  originCountry      String?
  grade              String?
  processingMethod   String?
  arabicaPercent     Int?
  robustaPercent     Int?
  body               Int?
  sweetness          Int?
  caffeineLevel      Int?
  aiProfile          String?
  profileConfidence  String?
  researchSourceUrl  String?
  sourceNote         String?
  createdAt          DateTime @default(now())
}

model User {
  id           Int           @id @default(autoincrement())
  phone        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  sessions     Session[]
  orders       Order[]
  addresses    UserAddress[]
}

model UserAddress {
  id             Int      @id @default(autoincrement())
  label          String   @default("آدرس من")
  recipientName  String
  recipientPhone String
  province       String
  city           String
  postalAddress  String
  postalCode     String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int

  @@index([userId])
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  phone        String         @unique
  passwordHash String
  name         String?
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model Session {
  token     String   @id
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AdminSession {
  token     String    @id
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model PasswordResetCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
